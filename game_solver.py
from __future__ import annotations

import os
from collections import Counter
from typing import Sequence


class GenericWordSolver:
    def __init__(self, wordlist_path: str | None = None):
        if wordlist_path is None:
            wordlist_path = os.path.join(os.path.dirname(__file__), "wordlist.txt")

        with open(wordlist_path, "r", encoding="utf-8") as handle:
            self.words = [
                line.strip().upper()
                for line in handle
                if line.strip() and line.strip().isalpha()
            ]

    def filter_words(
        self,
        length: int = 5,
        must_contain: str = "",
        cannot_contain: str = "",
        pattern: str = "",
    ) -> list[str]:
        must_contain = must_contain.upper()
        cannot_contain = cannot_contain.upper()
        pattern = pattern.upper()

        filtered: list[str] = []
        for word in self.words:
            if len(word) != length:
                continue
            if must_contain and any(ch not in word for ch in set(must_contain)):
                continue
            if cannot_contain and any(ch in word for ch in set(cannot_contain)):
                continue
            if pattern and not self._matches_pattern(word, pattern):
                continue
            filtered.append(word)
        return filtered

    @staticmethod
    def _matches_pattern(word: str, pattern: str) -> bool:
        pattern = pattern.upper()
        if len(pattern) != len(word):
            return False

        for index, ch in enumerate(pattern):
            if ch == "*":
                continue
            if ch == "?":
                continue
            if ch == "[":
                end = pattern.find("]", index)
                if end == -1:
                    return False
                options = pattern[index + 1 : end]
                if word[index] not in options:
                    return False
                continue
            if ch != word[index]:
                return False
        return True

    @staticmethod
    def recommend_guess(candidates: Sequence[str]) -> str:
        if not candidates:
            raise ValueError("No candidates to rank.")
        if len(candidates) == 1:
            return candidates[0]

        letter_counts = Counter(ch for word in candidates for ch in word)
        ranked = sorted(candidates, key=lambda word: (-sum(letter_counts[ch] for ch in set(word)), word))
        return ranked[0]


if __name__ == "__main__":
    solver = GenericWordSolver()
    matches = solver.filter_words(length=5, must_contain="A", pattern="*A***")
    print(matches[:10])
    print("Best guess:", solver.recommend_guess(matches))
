from __future__ import annotations

import argparse
import os
import tkinter as tk
from tkinter import filedialog, messagebox, ttk

from game_solver import GenericWordSolver
from image_processor import summarize_board_image
from wordle_solver import WordleSolver


def parse_history(raw_history: list[str]) -> list[tuple[str, str]]:
    history: list[tuple[str, str]] = []
    for item in raw_history:
        if ":" not in item:
            raise ValueError(f"Each history item must be in the form GUESS:PATTERN; got: {item}")
        guess, pattern = item.split(":", 1)
        guess = guess.strip().upper()
        pattern = pattern.strip().upper()
        if len(guess) != 5 or len(pattern) != 5:
            raise ValueError(f"Guess and pattern must both be 5 letters long: {guess!r} {pattern!r}")
        history.append((guess, pattern))
    return history


def solve_wordle(history: list[str]) -> str:
    solver = WordleSolver()
    data = parse_history(history)
    candidates = solver.filter_candidates(data)
    best = solver.recommend_guess(data)
    return (
        f"Remaining candidates: {len(candidates)}\n"
        f"Best next guess: {best}\n"
        + (f"Candidates: {candidates}\n" if len(candidates) <= 20 else "")
    )


def solve_custom(length: int, must_contain: str, cannot_contain: str, pattern: str) -> str:
    solver = GenericWordSolver()
    filtered = solver.filter_words(
        length=length,
        must_contain=must_contain.upper(),
        cannot_contain=cannot_contain.upper(),
        pattern=pattern.upper(),
    )
    if not filtered:
        return "No candidates match your rules."
    best = solver.recommend_guess(filtered)
    return f"Candidates found: {len(filtered)}\nBest guess: {best}\nSample: {filtered[:15]}"


class WordGameSolverApp(tk.Tk):
    def __init__(self) -> None:
        super().__init__()
        self.title("Word Game Solver")
        self.geometry("900x700")
        self.minsize(800, 600)

        self.game_var = tk.StringVar(value="wordle")

        main = ttk.Frame(self, padding=16)
        main.pack(fill="both", expand=True)

        ttk.Label(main, text="Game type").grid(row=0, column=0, sticky="w")
        game_combo = ttk.Combobox(main, textvariable=self.game_var, values=["wordle", "custom"], state="readonly", width=20)
        game_combo.grid(row=0, column=1, sticky="ew", padx=(8, 0), pady=(0, 10))

        ttk.Label(main, text="Image path").grid(row=1, column=0, sticky="w")
        self.image_path = tk.StringVar()
        image_entry = ttk.Entry(main, textvariable=self.image_path, width=50)
        image_entry.grid(row=1, column=1, sticky="ew", padx=(8, 8), pady=(0, 8))
        ttk.Button(main, text="Browse", command=self.pick_image).grid(row=1, column=2, sticky="e")

        ttk.Label(main, text="History (GUESS:PATTERN)").grid(row=2, column=0, sticky="nw")
        self.history_box = tk.Text(main, height=10, width=60)
        self.history_box.insert("end", "SLATE:GY___\nCRANE:YY___\n")
        self.history_box.grid(row=2, column=1, columnspan=2, sticky="nsew", padx=(8, 0), pady=(0, 10))

        controls = ttk.Frame(main)
        controls.grid(row=3, column=0, columnspan=3, sticky="ew", pady=(8, 12))

        ttk.Label(controls, text="Must contain").grid(row=0, column=0, padx=(0, 8), sticky="w")
        self.must_contain = tk.StringVar(value="")
        ttk.Entry(controls, textvariable=self.must_contain).grid(row=0, column=1, padx=(0, 8), sticky="ew")

        ttk.Label(controls, text="Cannot contain").grid(row=0, column=2, padx=(0, 8), sticky="w")
        self.cannot_contain = tk.StringVar(value="")
        ttk.Entry(controls, textvariable=self.cannot_contain).grid(row=0, column=3, padx=(0, 8), sticky="ew")

        ttk.Label(controls, text="Pattern").grid(row=1, column=0, padx=(0, 8), sticky="w")
        self.pattern = tk.StringVar(value="")
        ttk.Entry(controls, textvariable=self.pattern).grid(row=1, column=1, sticky="ew", padx=(0, 8))

        ttk.Label(controls, text="Length").grid(row=1, column=2, padx=(0, 8), sticky="w")
        self.length = tk.IntVar(value=5)
        ttk.Spinbox(controls, from_=3, to_=10, textvariable=self.length, width=8).grid(row=1, column=3, sticky="w")

        controls.grid_columnconfigure(1, weight=1)
        controls.grid_columnconfigure(3, weight=1)

        ttk.Button(main, text="Solve", command=self.solve).grid(row=4, column=0, columnspan=3, sticky="ew", pady=(0, 10))

        self.output = tk.Text(main, height=18, state="disabled", wrap="word")
        self.output.grid(row=5, column=0, columnspan=3, sticky="nsew")

        main.grid_columnconfigure(1, weight=1)
        main.grid_rowconfigure(5, weight=1)

    def pick_image(self) -> None:
        file_path = filedialog.askopenfilename(filetypes=[("Images", "*.png *.jpg *.jpeg *.bmp *.gif")])
        if file_path:
            self.image_path.set(file_path)

    def solve(self) -> None:
        try:
            if self.game_var.get() == "wordle":
                history_lines = [line.strip() for line in self.history_box.get("1.0", "end").splitlines() if line.strip()]
                if self.image_path.get():
                    try:
                        summary = summarize_board_image(self.image_path.get())
                        info = f"Image detection summary:\n{summary}\n"
                    except Exception as exc:
                        info = f"Image detection failed: {exc}\n"
                else:
                    info = ""

                result = solve_wordle(history_lines)
                display = info + result
            else:
                display = solve_custom(
                    length=int(self.length.get()),
                    must_contain=self.must_contain.get(),
                    cannot_contain=self.cannot_contain.get(),
                    pattern=self.pattern.get(),
                )

            self.output.config(state="normal")
            self.output.delete("1.0", "end")
            self.output.insert("end", display)
            self.output.config(state="disabled")
        except Exception as exc:
            messagebox.showerror("Solver error", str(exc))


def cli() -> None:
    parser = argparse.ArgumentParser(description="Universal word game solver")
    parser.add_argument("--game", choices=["wordle", "custom"], default="wordle")
    parser.add_argument("--history", action="append", default=[], help="History entries in GUESS:PATTERN format")
    parser.add_argument("--image", help="Optional screenshot image")
    parser.add_argument("--must-contain", default="")
    parser.add_argument("--cannot-contain", default="")
    parser.add_argument("--pattern", default="")
    parser.add_argument("--length", type=int, default=5)
    parser.add_argument("--show-candidates", action="store_true")
    args = parser.parse_args()

    if args.game == "wordle":
        if not args.history:
            print("No Wordle history provided. Use --history SLATE:GY___ ...")
            return
        result = solve_wordle(args.history)
        if args.image:
            try:
                result = f"Image detection: {summarize_board_image(args.image)}\n\n{result}"
            except Exception as exc:
                result = f"Image detection failed: {exc}\n\n{result}"
        print(result)
        return

    result = solve_custom(args.length, args.must_contain, args.cannot_contain, args.pattern)
    print(result)


if __name__ == "__main__":
    if os.environ.get("WORDGAME_GUI") == "1":
        WordGameSolverApp().mainloop()
    else:
        cli()
